# Public browser configuration. These values are visible to users of the site.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server configuration. The URL and publishable key match the project above.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only Supabase secret key. Never expose this with a VITE_ prefix.
# The legacy SUPABASE_SERVICE_ROLE_KEY variable name is also accepted.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Direct PostgreSQL connection used only by `bun run db:migrate`.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
